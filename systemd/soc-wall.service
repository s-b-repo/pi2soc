# Supervised SOC video-wall kiosk session.
#
# This replaces the old "getty autologin -> login shell sources soc.env" boot:
# the session runs as a systemd service so (a) the non-secret config is baked in
# as Environment= lines below — there is NO soc.env to read — and (b) Restart=always
# brings the whole session (compositor + panels) back if it ever dies, instead of
# leaving a black screen.
#
# setup.py generates the real unit (filling in the Environment= values from the
# wizard) at /etc/systemd/system/soc-wall.service; this checked-in copy is the
# reference template. The vault master is NOT here — it stays host-sealed under
# $SOC_SECRET_DIR and is fed to rbw by pinentry-vault.py.
#
# NOTE: a graphical session from a system service needs the seat/VT directives
# below (TTYPath/StandardInput=tty/PAMName); validate on the actual Pi.
[Unit]
Description=SOC video-wall kiosk session
After=systemd-user-sessions.service network-online.target vaultwarden.service
Wants=network-online.target vaultwarden.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=soc
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
UtmpIdentifier=tty1
UtmpMode=user

# --- non-secret config baked in (no soc.env) --------------------------------
Environment=SOC_VAULT_BACKEND=rbw
Environment=SOC_VAULT_EMAIL=
Environment=SOC_VAULT_URL=http://127.0.0.1:8222
Environment=SOC_SECRET_DIR=/etc/soc-display/secret
Environment="SOC_CONFIG_VAULT_ITEM=SOC Wall Config"
Environment=SOC_ROOT=/opt/soc-display
Environment=SOC_PANELS_FILE=/etc/soc-display/panels.yaml
Environment=SOC_INJECT_TMPL=/opt/soc-display/inject/login.js.tmpl
Environment=SOC_LAUNCH_STAGGER=1.5
Environment=SOC_READY_TIMEOUT=120
Environment=SOC_CDP_BASE_PORT=9222
Environment=SOC_CRED_TTL=30
Environment=SOC_VPN_DRY_RUN=0
Environment=SOC_SESSION=auto

# Ensure soc's XDG_RUNTIME_DIR exists BEFORE the session starts. The wall is
# launched via PAMName=login which usually sets this up — but on Wayland-only
# hosts (no full PAM session manager) the dir may be missing on cold boot, and
# rbw / pulseaudio / WebKit then fail with confusing "create dir / permission
# denied" errors. `+` runs the prep as root regardless of User=. Baked in
# after this session's bring-up flushed out the gap on a fresh install.
ExecStartPre=+/bin/sh -c '/usr/bin/install -d -m 0700 -o soc -g soc /run/user/$(id -u soc)'

ExecStart=/opt/soc-display/scripts/start-session.sh
Restart=always
RestartSec=3
# PERF-1: recycle a panel before the cgroup reclaim-thrashes (raised from 96).
Environment=SOC_MEM_MIN_AVAIL_MB=150
# SEC-7: physical-access config surface off by default; PIN mandatory if enabled.
Environment=SOC_ONSCREEN_CONFIG=0
Environment=SOC_CONFIG_REQUIRE_PIN=1
# PERF-1: MemoryHigh throttles a leaking dashboard via kernel reclaim. We
# deliberately do NOT set a hard MemoryMax: it would OOM-kill a process inside
# the cgroup and bounce the WHOLE session (black-screen blink) before the
# in-host memory watchdog can gracefully recycle one panel.
MemoryAccounting=yes
MemoryHigh=80%
# SEC-11: defense-in-depth (safe for the browser sandbox — does not restrict the
# SUID/devices the compositor + Chromium need).
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=graphical.target
